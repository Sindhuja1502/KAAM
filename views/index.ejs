      <a href="/worker/workerverification" class="role-card">
        <i class="fa-solid fa-screwdriver-wrench icon"></i>
        <h2>Worker</h2>
        <p>Find Jobs</p>
      </a>
    </div>

    <footer>
      <p>📞 Support: <strong>+91-98765-43210</strong></p>
    </footer>
