<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Post Work | Kaam</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
  <div class="container">
    <h1><i class="fa-solid fa-bullhorn"></i> Post a New Job</h1>
    <form action="#" method="post">
      <label for="jobTitle">Job Title:</label>
      <input type="text" id="jobTitle" name="jobTitle" required>

      <label for="description">Description:</label>
      <textarea id="description" name="description" rows="4" required></textarea>

      <label for="location">Location:</label>
      <input type="text" id="location" name="location" required>

      <label for="wage">Wage (per day):</label>
      <input type="number" id="wage" name="wage" required>

      <button type="submit" class="btn"><i class="fa-solid fa-paper-plane"></i> Post Job</button>
    </form>
  </div>
</body>
</html>
